{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/with-app-env.mjs vite build && node scripts/copy-pglite-assets.mjs && npm run db:migrate",
    "build:node": "node scripts/with-app-env.mjs vite build && node scripts/copy-pglite-assets.mjs",
    "start": "node scripts/start.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "test": "node --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --test src/lib/app-data/app-data.test.ts src/lib/meeqo/places.test.ts src/lib/app-data/readiness-schedule.test.ts src/lib/auth/gate-identity.test.ts src/lib/auth/sign-in-gate.test.ts src/lib/preview-path-prefix.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "node --experimental-strip-types --test src/lib/meeqo/places.test.ts src/lib/meeqo/ics.test.ts src/lib/meeqo/time.test.ts src/lib/meeqo/parse.test.ts src/lib/meeqo/fit.test.ts src/lib/meeqo/weather.test.ts src/lib/meeqo/icebreakers.test.ts src/lib/meeqo/attendance.test.ts src/lib/meeqo/region.test.ts src/lib/meeqo/now-here.test.ts src/lib/fcm.test.ts",
    "test:e2e": "node --test --test-concurrency=1 e2e/smoke.test.mjs e2e/english.test.mjs e2e/datenschutz.test.mjs e2e/region.test.mjs",
    "native:sync": "node scripts/native-sync.mjs",
    "native:android": "npm run native:sync && cap open android",
    "native:ios": "npm run native:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
